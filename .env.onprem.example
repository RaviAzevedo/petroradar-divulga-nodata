# =============================================================================
# Petro Radar — .env ON-PREMISE (modelo). COPIE para .env.onprem e preencha.
# NUNCA versione o .env.onprem real. Permissao recomendada: chmod 600.
# =============================================================================
# Geracao de segredos:
#   AUTH_SECRET   : openssl rand -base64 32
#   CRON_SECRET   : openssl rand -hex 32
#   SETUP_TOKEN   : openssl rand -hex 32
# =============================================================================

# ─── Geral ────────────────────────────────────────────────────────────────────
NODE_ENV=production
TZ=America/Sao_Paulo
LOG_LEVEL=info                       # debug | info | warn | error

# ─── BANCO (Neon -> pgvector/pg16 em container) ──────────────────────────────
# Credenciais usadas pelo container 'db' (imagem postgres) no PRIMEIRO boot:
POSTGRES_DB=petro_radar
POSTGRES_USER=petro
POSTGRES_PASSWORD=TROQUE-esta-senha-forte
# URL que web/bff/worker usam para falar com o db (service name 'db', rede interna).
# SEM sslmode=require (rede Docker interna). Para TLS interno, use ?sslmode=verify-full + CA.
# AÇÃO DE CODIGO: trocar driver @neondatabase/serverless por pg+drizzle-orm/node-postgres.
DATABASE_URL=postgres://petro:TROQUE-esta-senha-forte@db:5432/petro_radar

# ─── TUNING POSTGRES (D7 — flags passadas ao 'command:' do servico db) ───────
# Defaults (sem estas envs) sao LEVES para dev (Mac 16GB compartilhado):
#   shared_buffers=512MB, effective_cache_size=1536MB, maintenance_work_mem=128MB,
#   work_mem=16MB, random_page_cost=1.1
# >>> PRODUCAO (host Linux dedicado 8-16GB) — descomente o bloco abaixo: <<<
# PG_SHARED_BUFFERS=2GB              # ~25% da RAM do host
# PG_EFFECTIVE_CACHE_SIZE=6GB        # ~75% da RAM (estimativa p/ o planner)
# PG_MAINTENANCE_WORK_MEM=512MB      # acelera CREATE INDEX (HNSW do acervo!)
# PG_WORK_MEM=32MB                   # por sort/hash; cuidado com muitos conns
# PG_RANDOM_PAGE_COST=1.1            # SSD/NVMe (default pg=4.0 assume HDD)
# Mudanca exige RECREATE do db: docker compose up -d db (pg_stat_statements
# ja e carregado sempre via shared_preload_libraries no compose).

# ─── AUTENTICACAO (NextAuth v5 — segredo COMPARTILHADO web<->bff) ─────────────
# Gerar com: openssl rand -base64 32. O codigo le AUTH_SECRET (fallback NEXTAUTH_SECRET).
# RECOMENDADO: sobrescrever encode/decode para JWS HS256 antes de plugar o BFF.
AUTH_SECRET=TROQUE-openssl-rand-base64-32
NEXTAUTH_SECRET=TROQUE-openssl-rand-base64-32
# URLs publicas (dominio interno https da Proponente, atras do NGINX):
NEXTAUTH_URL=https://radar.example.local
APP_URL=https://radar.example.local
NEXT_PUBLIC_APP_URL=https://radar.example.local
# Token p/ criar o 1o admin via POST /api/auth/setup (openssl rand -hex 32):
SETUP_TOKEN=TROQUE-openssl-rand-hex-32
# Nome do cookie de sessao que o BFF procura/usa como salt HKDF do JWE
# (bff/app/core/config.py le AUTH_COOKIE_NAME; default authjs.session-token).
# >>> OBRIGATORIO EM PRODUCAO (HTTPS atras do NGINX): o Auth.js prefixa o cookie
# com __Secure- quando servido em HTTPS — deixe EXPLICITO o nome real: <<<
AUTH_COOKIE_NAME=__Secure-authjs.session-token
# EM DEV (http://localhost, sem TLS) troque para o nome sem prefixo:
#   AUTH_COOKIE_NAME=authjs.session-token
# (O BFF tenta "<nome>" e "__Secure-<nome>" ao LER o cookie, mas o salt correto
# na primeira tentativa evita decode duplo — seja explicito por ambiente.)

# ─── HARDENING DE SESSAO (fail-closed) ───────────────────────────────────────
# >>> OBRIGATORIO EM PRODUCAO: os TRES abaixo DEVEM ser 1 (fail-closed). <<<
# O DEFAULT DO CODIGO e 0 (fail-open, para nao travar dev) — um .env.onprem de
# producao que omita estas chaves HERDA o fail-open. Nao omita.
# Login (Next, app/src/lib/auth.ts): com 1, NEGA o login se nao houver rate-limit
# distribuido (Redis indisponivel) em vez de degradar p/ limiter in-process.
AUTH_FAILCLOSED=1
# Revogacao de sessao (BFF, app/core/revocation.py): com 1, se o Redis db2 cair
# o token e tratado como revogado (401) em vez de aceito ate o exp.
REVOCATION_FAILCLOSED=1
# Rate-limit global do BFF (app/core/rate_limit.py): com 1, se o Redis cair TODA
# rota com limite responde 429 (mesmo as marcadas fail_open).
# TRADE-OFF: fail-closed prioriza SEGURANCA sobre DISPONIBILIDADE — queda do
# Redis nega a API inteira (429) ate ele voltar. Como o Redis e local (mesmo
# compose, AOF + restart automatico), a janela esperada e de segundos. Se a TI
# preferir disponibilidade, use 0 SABENDO que sem Redis nao ha rate-limit algum.
RATE_LIMIT_FAILCLOSED=1
# TTL da denylist de jti = 9h (maxAge 8h + folga clock-skew). NAO reduzir abaixo do maxAge.
JWT_REVOCATION_TTL_SECONDS=32400

# ─── URLs INTERNAS (container -> container) ──────────────────────────────────
# Usadas pelo worker/scheduler para chamar crons e pelo bff. Service names do compose.
APP_BASE_URL=http://web:3000
BFF_BASE_URL=http://bff:8000

# ─── CORS do BFF (origens de navegador permitidas) ───────────────────────────
# >>> OBRIGATORIO EM PRODUCAO: defina a(s) origem(ns) REAL(is) do front. <<<
# Lista separada por VÍRGULA das origens (scheme://host[:porta]) autorizadas a
# chamar o BFF a partir do navegador. NUNCA use "*" (curinga) — o BFF envia
# credenciais (allow_credentials=True), e "*" com credenciais é bloqueado pelo
# browser e é inseguro. Sem esta env, o codigo (bff/app/core/config.py) cai no
# default de DEV http://localhost:3000 — em producao isso BLOQUEIA o front real.
# PRODUCAO (exemplo real — dominio interno servido pelo NGINX com TLS):
#   CORS_ORIGINS=https://radar.example.local
# DEV (front direto na porta 3000):
CORS_ORIGINS=http://localhost:3000

# ─── IA Anthropic (MANTIDA externa — liberar egress p/ api.anthropic.com) ────
ANTHROPIC_API_KEY=sk-ant-...
# Triagem semantica IA por cron (beat HH:15). Ligue SO com chave real valida —
# com placeholder o cron falharia em loop (401). 0 = beat nao agenda a triagem.
TRIAGEM_IA_ENABLED=0
# Valores REAIS + vencedor/metadados de contratos via Portal da Transparencia
# Petrobras (publico, sem chave; Playwright p/ WAF). DEFAULT LIGADO (beat
# diario 10:40 UTC). Ponha 0 em ambiente air-gapped sem egress para
# sistematransparencia.petrobras.com.br.
TRANSPARENCIA_ENABLED=1
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODELO_HAIKU=claude-haiku-4-5    # alias PT (manter igual ao de cima)
# LGPD/DPIA (auditoria 02/07): gate do OCR que ENVIA o PDF do cofre à Anthropic.
# Default CONSERVADOR = false (o upload segue sem OCR). Só ligar (=true) APÓS
# assinar o DPA/contrato com a Anthropic e o sign-off do DPO (ver WP09 §DPIA).
OCR_IA_ENABLED=false

# ─── BRIEFING / DOSSIE POR IA (DESLIGADO EM 05/08/2026) ──────────────────────
# Chave geral dos DOIS caminhos que produzem briefing por IA:
#   GET  /api/licitacoes/[id]/briefing  (PDF/MD/JSON)
#   POST /api/licitacoes/[id]/dossie    (Claude -> ZIP que CONTEM o briefing PDF)
# Desligada a pedido do dono ate resolver um problema da geracao. Default = OFF:
# so liga com o valor exatamente "1". Analise de edital, Go/No-Go e GAP de
# habilitacao NAO sao afetados. Lida em RUNTIME pelo servidor (nao e NEXT_PUBLIC),
# entao religar = editar aqui + `docker compose up -d web`, sem rebuild.
FEATURE_BRIEFING_IA=0

# ─── EXTRACAO AUTOMATICA DO TEXTO DOS ANEXOS ────────────────────────────────
# Cron /api/cron/extrair-anexos (beat: cron-extrair-anexos, a cada 20 min).
# Deixa o edital MASTIGADO antes de alguem pedir a analise. Sem ele, a rota de
# analise caia em licitacoes.objeto (70 caracteres em media) e gerava um briefing
# completo de 12 secoes sobre nada — ver migration 0032.
#
# Escopo: so licitacoes ABERTAS e RELEVANTES (ALTA/MEDIA em Recebendo Propostas).
# Extrair TODAS as licitacoes levaria texto_cache a alguns GB, varias vezes o
# tamanho do resto do banco.
#
# O orcamento fica abaixo do timeout de 300s do cron_trigger: a rota devolve o
# relatorio sozinha e a proxima rodada continua de onde parou (idempotente).
CRON_EXTRAIR_ANEXOS_ENABLED=1
CRON_EXTRAIR_ANEXOS_MAX_LIC=8
CRON_EXTRAIR_ANEXOS_ORCAMENTO_S=210

# ─── EMBEDDINGS / RAG (DECISAO TRAVADA 19/06: 100% ON-PREM, BGE-m3/1024) ─────
# Modelo local BGE-m3 servido pelo container 'embeddings-local' (HuggingFace TEI).
# PRE-REQUISITO: migrar acervo_chunks de vector(1536) -> vector(1024), recriar o
# indice HNSW e RE-EMBEDDAR todo o acervo (migration 0015).
# (Voyage/OpenAI permanecem suportados no codigo como fallback — basta trocar abaixo.)
FEATURE_ACERVO_RAG=true
EMBEDDING_PROVIDER=local              # local (on-prem) | voyage | openai
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSOES=1024              # BGE-m3 = 1024. DEVE casar com a coluna vector(N).
EMBEDDING_BASE_URL=http://embeddings-local:80   # endpoint do TEI (provider=local)
VOYAGE_API_KEY=                       # so se trocar EMBEDDING_PROVIDER=voyage
OPENAI_API_KEY=                       # so se trocar EMBEDDING_PROVIDER=openai
ACERVO_TOP_K=8
ACERVO_SIMILARIDADE_MIN=0.35
ACERVO_CHUNK_TAMANHO=1200
ACERVO_CHUNK_OVERLAP=200
ACERVO_BUDGET_CHUNKS=800

# Candidatos por braço da busca híbrida (vetor, texto estrito, texto amplo)
# antes da fusão RRF, e teto de exploração do grafo HNSW por consulta.
#
# ACERVO_EF_SEARCH tem de ser >= ACERVO_CANDIDATOS. Abaixo disso o pgvector
# TRUNCA o braço vetorial em silêncio: com o default do pgvector (40), um
# LIMIT 200 devolvia as mesmas ~44 linhas de um LIMIT 60 — o braço vetorial
# rodava a 70% da largura configurada e ninguém percebia.
#
# Medido contra uma regua interna de 40 perguntas, ponta a ponta:
#   ef=40  cand=60    hit@5 75%  hit@10 85%  MRR 0,636   mediana 446 ms
#   ef=400 cand=120   hit@5 85%  hit@10 90%  MRR 0,745   mediana 474 ms
#
# O custo é ~7 ms quando o índice HNSW cabe inteiro no shared_buffers
# (acerto de cache ~100%). Num host com menos memória, remedir antes.
ACERVO_CANDIDATOS=120
ACERVO_EF_SEARCH=400

# Teto do ping de saude ao servico de embeddings antes de cada ciclo do cron
# acervo-index. NAO baixe: sob carga o /health do TEI enfileira atras da
# inferencia e leva de 5 a 22s para responder (medido). Um teto curto faz o cron
# recusar a propria execucao seguinte e o backfill trava.
EMBEDDING_HEALTH_TIMEOUT_MS=30000

# Origens que o cron acervo-index pode indexar (lista por virgula). Vazio = as
# duas. Serve para PRIORIZAR um backfill: os anexos de edital costumam ser varias vezes o
# volume do cofre e entram na fila primeiro, entao carregar o acervo tecnico do
# zero sem este seletor significa esperar toda a fila de anexos.
#   ACERVO_INDEX_ORIGENS=DOC_HABILITACAO
ACERVO_INDEX_ORIGENS=
ACERVO_BUDGET_FONTES=50

# ─── STORAGE (Cloudflare R2 -> MinIO) ────────────────────────────────────────
# Mantemos os nomes R2_* (so repontados) + NOVO R2_ENDPOINT explicito.
# AÇÃO DE CODIGO: getR2Client deve usar R2_ENDPOINT em vez de derivar do account id.
R2_ENDPOINT=http://minio:9000        # endpoint interno do MinIO
R2_BUCKET=petro-radar
R2_ACCESS_KEY_ID=petro-radar-app     # service account criado pelo bootstrap (menor privilegio)
R2_SECRET_ACCESS_KEY=TROQUE-secret-do-service-account
R2_REGION=us-east-1                  # placeholder; MinIO ignora
# Credenciais ROOT do MinIO (usadas pelo container 'minio' e pelo bootstrap):
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=TROQUE-senha-root-minio-forte

# ─── REDIS (Upstash -> Redis container). rate-limit + cache + broker Celery ──
# AÇÃO DE CODIGO: trocar adapter REST por client TCP (ioredis/redis) usando REDIS_URL.
REDIS_PASSWORD=TROQUE-senha-redis-forte
REDIS_URL=redis://:TROQUE-senha-redis-forte@redis:6379/0       # db0 = rate-limit/cache
CELERY_BROKER_URL=redis://:TROQUE-senha-redis-forte@redis:6379/1
CELERY_RESULT_BACKEND=redis://:TROQUE-senha-redis-forte@redis:6379/2
REDIS_MAXMEMORY=512mb

# ─── BUSCA FULL-TEXT ─────────────────────────────────────────────────────────
# Elasticsearch REMOVIDO (2026-07-02): era destino so-de-escrita; a busca do
# app/BFF usa ILIKE no Postgres. Evolucao futura: tsvector+unaccent+pg_trgm.

# ─── E-MAIL (Microsoft Graph — TRANSPORTE UNICO) ─────────────────────────────
# ATENCAO: o transporte de e-mail e o Microsoft Graph e SO ELE. Os transportes
# SMTP (nodemailer) e Resend foram REMOVIDOS do app (src/lib/email/send.ts) em
# 2026-07-13 — NAO existe mais fallback. Sem GRAPH_MAIL_SENDER o sistema nao
# envia NENHUM e-mail (prazos, vencimentos, circulares, cnpj, digest, relatorio,
# sync-monitor) e a unica pista e um logger.warn: as rotas de cron continuam
# devolvendo ok:true. A falha e SILENCIOSA. Configure a caixa ANTES do cutover.
#
# A config obrigatoria de e-mail e GRAPH_MAIL_SENDER, na secao "Microsoft Graph"
# mais abaixo (junto do SSO, que fornece o App Registration usado no envio).
#
# SMTP_*/RESEND_*/FROM_EMAIL: REMOVIDOS deste template — nao sao mais lidos pelo
# app. (O adapter SMTP do BFF em bff/app/core/email.py so seria exercitado com
# CRON_TARGET=bff, que NAO e suportado para e-mail: os crons do BFF nao passam
# pela guarda de tenant nem pelos templates novos. Mantenha CRON_TARGET=web.)

# ─── RETENCAO LGPD (worker) ──────────────────────────────────────────────────
# DRY-RUN por padrao: a task retencao_expurgo so CONTA o que seria expurgado
# (SELECT count(*)) e loga. Mudar para 0 SOMENTE apos aprovacao juridica/DPO.
RETENCAO_DRY_RUN=1

# ─── CRONS (seguranca) ───────────────────────────────────────────────────────
# OBRIGATORIO em prod. Com CRON_SECRET setado, verifyCronAuth exige Bearer sempre
# (o caminho x-vercel-cron deixa de existir). NGINX bloqueia /api/cron/* externo.
CRON_SECRET=TROQUE-openssl-rand-hex-32
# Toggles/limiares (vazio = ligado; "false" desliga):
CRON_TRIAGEM_ENABLED=
CRON_TRIAGEM_LOTE=30
CRON_TRIAGEM_SCORE_ALTO=70
CRON_TRIAGEM_MAX_CHARS=12000
CRON_CONVOCACAO_WATCH_ENABLED=
CRON_CONVOCACAO_POSICAO_MIN=2
CRON_ACERVO_INDEX_ENABLED=
CRON_DIGEST_EXECUTIVO_ENABLED=
CRON_RELATORIO_MENSAL_ENABLED=

# ─── CRONS: ALVO DO DISPARO (flip estrangulador com rollback em 1 env) ───────
# Os crons do beat disparam GET /api/cron/<nome>. CRON_TARGET decide o alvo:
#   web (default) -> Next.js  (APP_BASE_URL, http://web:3000)
#   bff           -> FastAPI (BFF_BASE_URL, http://bff:8000) — mesmos paths.
# ROLLBACK: se algo quebrar apos o flip p/ bff, volte CRON_TARGET=web e
# recrie o worker (docker compose up -d worker) — sem rebuild, sem deploy.
CRON_TARGET=web

# ─── OBSERVABILIDADE (Sentry SaaS -> GlitchTip self-hosted, opcional) ────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=onprem
SENTRY_TRACES_SAMPLE_RATE=0
METRICS_ENABLED=1

# ─── CUSTOS DE IA (G3/G4) ───────────────────────────────────────────────────
# Teto diário de tokens Anthropic (input+output somados). 0 = ilimitado.
# Quando excedido, crons de IA (ex.: triagem-semantica) pulam com skip logado.
IA_BUDGET_TOKENS_DAILY=0

# ─── BUSCA (E12 — acento-insensível + ranking trigram) ───────────────────────
# "1" liga f_unaccent+similarity() em /api/licitacoes/search (Next + BFF).
# Default OFF preserva ILIKE byte-a-byte (paridade e2e). Requer migration 0018.
SEARCH_TRGM=0

# ─── GRAFANA / ALERTAS (docker-compose.observability.yml, opt-in) ───────────
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=troque-senha-forte
# GRAFANA_ROOT_URL=http://localhost:3001
# ALERT_EMAIL_TO=ti@example.com

# ─── EMPRESA (publico, build-time — sao NEXT_PUBLIC_* e exigem REBUILD) ──────
NEXT_PUBLIC_PROPONENTE_CNPJ=11222333000181
NEXT_PUBLIC_PROPONENTE_NOME=Proponente
NEXT_PUBLIC_PROPONENTE_RAZAO_SOCIAL=PROPONENTE ENGENHARIA LTDA
NEXT_PUBLIC_PROPONENTE_TELEFONE=(00) 0000-0000
NEXT_PUBLIC_PROPONENTE_CIDADE_UF=Cidade, UF
NEXT_PUBLIC_PROPONENTE_ENDERECO=
NEXT_PUBLIC_PETRONECT_URL=https://www.petronect.com.br
NEXT_PUBLIC_FEATURE_RESULTADOS=true

# ─── BACKUP (deploy/backup.sh — timer systemd diario 02:30) ──────────────────
# Estes valores sao lidos pelo backup.sh do AMBIENTE do processo (systemd unit
# ou shell), nao do .env.onprem — documentados aqui como referencia canonica.
# >>> OBRIGATORIO EM PRODUCAO: cifragem age + offsite + require-encryption. <<<
# Cifragem do dump Postgres com age (https://age-encryption.org):
#   age-keygen -o /root/petro-backup.key    (guarde a IDENTITY offline/cofre!)
#   BACKUP_AGE_RECIPIENT=age1...            (chave PUBLICA, linha "public key:")
# Fallback: se 'age' nao estiver instalado mas 'gpg' sim, use passphrase:
#   BACKUP_GPG_PASSPHRASE_FILE=/root/.petro-backup-pass   (chmod 400)
# BACKUP_AGE_RECIPIENT=
# BACKUP_GPG_PASSPHRASE_FILE=
# Com 1, o backup FALHA se nao conseguir cifrar (producao). Sem a flag, segue
# em claro com warning alto (dev).
# BACKUP_REQUIRE_ENCRYPTION=1
# Destino offsite (NAS/segundo disco montado). Copia SO o artefato cifrado +
# manifesto, com verificacao pos-copia e retencao propria:
# BACKUP_OFFSITE_DIR=/mnt/nas/petro-backups
# BACKUP_OFFSITE_RETENTION_DAYS=30
# Retencao local (host): N diarios + M semanais (domingos):
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# Restore de dump cifrado (.age) — deploy/restore.sh precisa da IDENTITY:
# BACKUP_AGE_IDENTITY=/root/petro-backup.key

# ─── LIMITES ─────────────────────────────────────────────────────────────────
PACOTE_LIMITE_BYTES=209715200        # 200 MB (teto de ZIP do pacote-orcamento)
BFF_WORKERS=2

# ─── REMOVIDAS no on-prem (NAO usar) ─────────────────────────────────────────
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN  -> Redis container
# R2_ACCOUNT_ID                                      -> R2_ENDPOINT explicito
# RESEND_API_KEY / SMTP_*                            -> Microsoft Graph (GRAPH_MAIL_SENDER)

# ─── NextAuth atrás de proxy/NGINX (on-prem) ─────────────────────────────────
# Faz o NextAuth confiar no host encaminhado pelo NGINX (senão rejeita o login
# quando o host != NEXTAUTH_URL). OBRIGATÓRIO no on-prem.
AUTH_TRUST_HOST=true
# (Apple Silicon) plataforma do container de embeddings TEI (amd64 emulado):
# EMBEDDINGS_PLATFORM=linux/amd64

# ══════════════════════════════════════════════════════════════════════════════
# SSO Microsoft 365 (Entra ID)
# ══════════════════════════════════════════════════════════════════════════════
# App Registration single-tenant no Azure (entra.microsoft.com → App
# registrations). Redirect URI (Web): <host>/api/auth/callback/microsoft-entra-id
# [OBRIGATORIAS para o login SSO — sem elas so entra AUTH_BREAKGLASS=1]
AUTH_MICROSOFT_ENTRA_ID_ID=TROQUE-application-client-id
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=TROQUE-directory-tenant-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=TROQUE-client-secret-value
# Dominios de e-mail aceitos no SSO (CSV) — barra convidados B2B do tenant.
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
# Bootstrap de instalacao LIMPA: e-mail que vira ADMIN no 1o login quando nao
# existe nenhum ADMIN ativo (inerte depois de existir ADMIN). [OPCIONAL]
#SEED_ADMIN_EMAIL=admin@example.com
# Break-glass: 1 liga o login local por senha em /login/local (emergencia ou
# air-gap). Default 0 = SSO-only. [OPCIONAL]
AUTH_BREAKGLASS=0

# ─── E-mail via Microsoft Graph (TRANSPORTE UNICO) ────────────────────────────
# [OBRIGATORIO p/ e-mail] Caixa REMETENTE no tenant Proponente. Reusa o App
# Registration do SSO (AUTH_MICROSOFT_ENTRA_ID_*). Requer no Azure/Exchange:
# shared mailbox remetente + permissao de APLICACAO Mail.Send c/ admin consent
# + Application Access Policy restringindo o app a ESTA caixa.
#
# NAO EXISTE FALLBACK. Esta env vazia = ZERO e-mail sai do sistema, em silencio
# (send.ts:131 -> graphMailAtivo() false -> {ok:false} e um logger.warn). Ela e
# a UNICA chave que liga o e-mail: se a caixa ainda nao existe, trate como
# PENDENCIA DE CUTOVER, nao como "opcional".
#
# EGRESS necessario (o firewall PRECISA liberar, senao nao sai e-mail):
#   login.microsoftonline.com:443   (token client-credentials)
#   graph.microsoft.com:443         (sendMail)
GRAPH_MAIL_SENDER=TROQUE-no-reply@example.com
GRAPH_MAIL_SAVE_SENT=0
# Digest de licitacoes por filtro de e-mail (0026). [OPCIONAIS]
CRON_DIGEST_LICITACOES_ENABLED=
CRON_DIGEST_LICITACOES_MAX_ITENS=30
