# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Neon PostgreSQL (serverless) — região sa-east-1 (São Paulo)
# [OBRIGATÓRIA]
DATABASE_URL=postgresql://user:pass@localhost:5432/petro_radar?sslmode=require

# ─── Autenticação (NextAuth v5) ───────────────────────────────────────────────
# Segredo de assinatura dos tokens. Gerar com: openssl rand -base64 32
# O código lê AUTH_SECRET (com fallback para NEXTAUTH_SECRET).
# [OBRIGATÓRIA] — defina pelo menos uma das duas
AUTH_SECRET=gerar-com-openssl-rand-base64-32
NEXTAUTH_SECRET=gerar-com-openssl-rand-base64-32
# URL base da aplicação (usada em links de e-mail e callbacks)
# [OBRIGATÓRIA]
NEXTAUTH_URL=http://localhost:3000
# URL pública usada por jobs externos (GitHub Actions) ao notificar.
# Fallback para NEXTAUTH_URL quando ausente. [OPCIONAL]
APP_URL=https://radar.example.com

# ─── Setup inicial ────────────────────────────────────────────────────────────
# Token exigido para criar o primeiro admin via POST /api/auth/setup em produção.
# Gerar com: openssl rand -hex 32. [OPCIONAL] (recomendado em produção)
SETUP_TOKEN=gerar-com-openssl-rand-hex-32

# ─── Claude API (Anthropic) ───────────────────────────────────────────────────
# Lida implicitamente pelo SDK (new Anthropic()) em análise IA e OCR de anexos.
# [OBRIGATÓRIA] (para os módulos de análise/OCR)
ANTHROPIC_API_KEY=sk-ant-...

# ─── Cloudflare R2 (armazenamento de documentos) ─────────────────────────────
# S3-compatible via @aws-sdk/client-s3 — egress grátis, 10 GB no Forever Free.
# Endpoint é derivado do account ID: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# [OBRIGATÓRIAS] (para upload/download de DFP, PPU e anexos)
R2_ACCOUNT_ID=id-da-conta-cloudflare-32-chars-hex
R2_ACCESS_KEY_ID=access-key-gerada-no-r2-api-tokens
R2_SECRET_ACCESS_KEY=secret-correspondente
R2_BUCKET=petro-radar

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Obter em: https://resend.com → API Keys
# Necessário para notificações de prazo, aprovações e alertas. [OPCIONAL]
RESEND_API_KEY=re_...
# Remetente dos e-mails. Código lê RESEND_FROM_EMAIL (fallback FROM_EMAIL). [OPCIONAL]
RESEND_FROM_EMAIL=Petro Radar <no-reply@example.com>

# ─── Cron Jobs (segurança) ────────────────────────────────────────────────────
# Token para autenticar chamadas dos crons da Vercel (/api/cron/*) e do
# endpoint de notificação de troca de vencedor. Gerar com: openssl rand -hex 32
# [OBRIGATÓRIA] (em produção)
CRON_SECRET=gerar-com-openssl-rand-hex-32

# ─── GitHub Actions (coleta externa) ─────────────────────────────────────────
# Token (PAT) com permissão de workflow:write para disparar a coleta via API.
# O coletor do portal NÃO faz parte deste repositório. [OPCIONAL]
GITHUB_SYNC_TOKEN=ghp_...
# Repositório do workflow no formato "owner/repo". [OPCIONAL]
GITHUB_REPO=owner/repo

# ─── Rate limiting (Upstash Redis) ───────────────────────────────────────────
# Quando ausente, o rate limit é desabilitado (no-op). [OPCIONAL]
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Observabilidade ──────────────────────────────────────────────────────────
# Nível de log: debug | info | warn | error. Default: debug (dev) / info (prod). [OPCIONAL]
LOG_LEVEL=
# Sentry — se SENTRY_DSN ausente, o Sentry fica desligado. [OPCIONAL]
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# ─── Configuração da empresa (público, build-time) ───────────────────────────
# Todas têm default no código; sobrescreva apenas se necessário. [OPCIONAL]
NEXT_PUBLIC_PROPONENTE_CNPJ=11222333000181
NEXT_PUBLIC_PROPONENTE_NOME=Proponente
NEXT_PUBLIC_PROPONENTE_RAZAO_SOCIAL=PROPONENTE ENGENHARIA LTDA
NEXT_PUBLIC_PROPONENTE_TELEFONE=(00) 0000-0000
NEXT_PUBLIC_PROPONENTE_CIDADE_UF=Cidade, UF
NEXT_PUBLIC_PROPONENTE_ENDERECO=
NEXT_PUBLIC_PETRONECT_URL=https://www.petronect.com.br

# ─── Feature flags (módulos em reconstrução) ─────────────────────────────────
# Setar para "true" reativa o módulo. Vazio/ausente = desabilitado. [OPCIONAL]
NEXT_PUBLIC_FEATURE_RESULTADOS=

# ══════════════════════════════════════════════════════════════════════════════
# 25 FEATURES NOVAS (PR #11) — todas opcionais; sem o env a feature fica gated/no-op
# ══════════════════════════════════════════════════════════════════════════════

# ─── RAG / Embeddings (busca semântica do acervo — requer pgvector no Neon) ──
# CREATE EXTENSION vector; no Neon antes de aplicar a migration 0014.
FEATURE_ACERVO_RAG=
EMBEDDING_PROVIDER=        # ex.: openai | voyage (conforme implementação)
EMBEDDING_MODEL=           # ex.: text-embedding-3-small
EMBEDDING_DIMENSOES=1536   # deve casar com a coluna vector(1536) da migration
ACERVO_TOP_K=8
ACERVO_SIMILARIDADE_MIN=0.5
ACERVO_CHUNK_TAMANHO=1200
ACERVO_CHUNK_OVERLAP=200
ACERVO_BUDGET_CHUNKS=500   # teto de chunks indexados por execução do cron
ACERVO_BUDGET_FONTES=50

# ─── Modelos Anthropic (centralizados; todos têm fallback se ausentes) ───────
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5
ANTHROPIC_MODELO_HAIKU=claude-haiku-4-5   # alias usado por algumas libs (manter igual)

# ─── Toggles dos crons das features (vazio = ligado; "false" desliga) ────────
CRON_TRIAGEM_ENABLED=
CRON_TRIAGEM_LOTE=30
CRON_TRIAGEM_SCORE_ALTO=70
CRON_CONVOCACAO_WATCH_ENABLED=
CRON_CONVOCACAO_POSICAO_MIN=2
CRON_ACERVO_INDEX_ENABLED=
CRON_DIGEST_EXECUTIVO_ENABLED=
CRON_RELATORIO_MENSAL_ENABLED=

# ─── Railway dispatcher (agendamento de crons + sync — PR #10) ───────────────
# O dispatcher chama as rotas /api/cron na Vercel; precisa da URL base + CRON_SECRET.
APP_BASE_URL=https://radar.example.com

# ─── SSO Microsoft 365 (Entra ID) ─────────────────────────────────────────────
# Login corporativo (tenant da empresa). App Registration single-tenant;
# redirect URI (Web):
#   <host>/api/auth/callback/microsoft-entra-id
# [OBRIGATÓRIAS para o login SSO] — sem as 3, o provider não é registrado e só
# entra quem tiver AUTH_BREAKGLASS=1 (login local por senha em /login/local).
AUTH_MICROSOFT_ENTRA_ID_ID=application-client-id
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=directory-tenant-id
AUTH_MICROSOFT_ENTRA_ID_SECRET=client-secret-value
# Domínios de e-mail aceitos no SSO (CSV; default example.com) [OPCIONAL]
AUTH_ALLOWED_EMAIL_DOMAINS=example.com
# Bootstrap: e-mail que vira ADMIN no 1º login quando não há ADMIN ativo [OPCIONAL]
#SEED_ADMIN_EMAIL=admin@example.com
# Break-glass: 1 reativa o login local por senha (/login/local) [OPCIONAL]
AUTH_BREAKGLASS=0

# ─── E-mail via Microsoft Graph (Transporte 0) — 0026 ─────────────────────────
# Presença de GRAPH_MAIL_SENDER ativa o Graph antes do SMTP (caixa do tenant;
# exige Mail.Send Application + admin consent + Access Policy). [OPCIONAL]
GRAPH_MAIL_SENDER=
GRAPH_MAIL_SAVE_SENT=0
# Digest de licitações por filtro de e-mail (0026) [OPCIONAIS]
CRON_DIGEST_LICITACOES_ENABLED=
CRON_DIGEST_LICITACOES_MAX_ITENS=30
