# ══════════════════════════════════════════════════════════════════════════════
# Petro Radar BFF (FastAPI on-premise) — variáveis de ambiente
# Copie para .env e preencha. Lido por app/core/config.py (pydantic-settings).
# ══════════════════════════════════════════════════════════════════════════════

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# Aceita postgresql://... — convertido internamente para postgresql+asyncpg://.
# O parâmetro sslmode na query é removido automaticamente (asyncpg não o aceita).
# [OBRIGATÓRIA]
DATABASE_URL=postgresql://user:pass@localhost:5432/petro_radar

# ─── Autenticação (validação do JWT emitido pelo NextAuth v5) ─────────────────
# AUTH_SECRET é o canônico; NEXTAUTH_SECRET é fallback. Deve ser IGUAL ao
# segredo configurado no container Next.js. Gerar com: openssl rand -base64 32
# PRÉ-REQUISITO: o NextAuth deve emitir JWS HS256 (não o JWE A256GCM padrão) —
# ver o caveat documentado em app/core/security.py.
# [OBRIGATÓRIA] — defina pelo menos uma das duas.
AUTH_SECRET=gerar-com-openssl-rand-base64-32
NEXTAUTH_SECRET=
# Nome do cookie de sessão do NextAuth (fallback quando não há header Bearer).
# v5 padrão: authjs.session-token (em HTTPS o prefixo vira __Secure-).
AUTH_COOKIE_NAME=authjs.session-token

# ─── Redis (cache / rate limit / health) ──────────────────────────────────────
# [OBRIGATÓRIA]
REDIS_URL=redis://localhost:6379/0

# ─── Anthropic (análise IA / OCR / RAG) ───────────────────────────────────────
# [OBRIGATÓRIA] para os módulos de IA
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-5
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5

# ─── Embeddings / RAG (acervo técnico, pgvector) ──────────────────────────────
# Provider: openai | voyage. Preencha a chave do provider escolhido.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
VOYAGE_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Deve casar com a coluna vector(1536) da tabela acervo_chunks.
EMBEDDING_DIMENSOES=1536

# ─── Armazenamento de objetos (S3 / Cloudflare R2 / MinIO on-prem) ────────────
# Para R2: endpoint = https://<account-id>.r2.cloudflarestorage.com
# [OBRIGATÓRIAS] para upload/download de DFP, PPU e anexos.
S3_ENDPOINT=https://minio.interno:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=petro-radar

# ─── CORS (origens internas permitidas) ───────────────────────────────────────
# CSV de origens. Inclua a URL do container Next.js.
CORS_ORIGINS=http://localhost:3000

# ─── Observabilidade ──────────────────────────────────────────────────────────
# Nível de log: debug | info | warn | error.
LOG_LEVEL=info
